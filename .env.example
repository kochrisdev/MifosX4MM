# ── Fineract ──────────────────────────────────────────
FINERACT_URL=http://localhost:8080/fineract-provider/api/v1
FINERACT_TENANT_ID=default
FINERACT_USERNAME=mifos
FINERACT_PASSWORD=password

# ── Keycloak ──────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=mifos
KEYCLOAK_CLIENT_ID=mifos-api
KEYCLOAK_CLIENT_SECRET=changeme-api-secret
KEYCLOAK_STAFF_CLIENT_ID=mifos-staff

# ── KBZ Pay ───────────────────────────────────────────
KBZPAY_APP_ID=your_app_id
KBZPAY_MERCHANT_CODE=your_merchant_code
KBZPAY_SIGN_KEY=your_sign_key
KBZPAY_BASE_URL=https://api.kbzpay.com/payment/gateway/uat
KBZPAY_CALLBACK_URL=https://your-domain.com/webhooks/kbzpay

# ── KYC ───────────────────────────────────────────────
KYC_PROVIDER=stub
# KYC_PROVIDER=smile_identity | onfido
# SMILE_IDENTITY_PARTNER_ID=
# SMILE_IDENTITY_API_KEY=
# ONFIDO_API_TOKEN=

# ── Database (reporting service) ──────────────────────
REPORTING_DB_URL=postgresql://mifos:password@localhost:5432/fineract_default

# ── API Gateway ───────────────────────────────────────
API_PORT=3001
JWT_SECRET=changeme_use_strong_secret_in_prod
REPORTING_SVC_URL=http://localhost:3005

# ── Web App ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_REPORTING_URL=http://localhost:3005

# ── Mobile App ────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_REPORTING_URL=http://localhost:3005
